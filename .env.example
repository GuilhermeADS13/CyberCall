# Copie para .env e preencha com os valores reais. NUNCA versione o .env.

# --- Banco de dados (MySQL/TiDB) -------------------------------------------
DATABASE_URL=mysql://usuario:senha@host:4000/cybercall

# --- Sessão e OAuth --------------------------------------------------------
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# --- Origens confiáveis ----------------------------------------------------
# Lista separada por vírgula com as origens autorizadas a fazer mutations e a
# abrir o WebSocket /api/realtime. A própria origem do servidor já é aceita;
# só preencha para liberar domínios extras (preview, app em outro domínio).
ALLOWED_ORIGINS=

# --- WebRTC ----------------------------------------------------------------
# Sem TURN a chamada falha em NAT simétrico, rede corporativa e parte do 4G.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- LLM / Forge (assistente e moderação de imagem) ------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Antimalware (libera PDFs e documentos quando configurado) -------------
CLOUDMERSIVE_API_KEY=

# --- Aparência e analytics -------------------------------------------------
VITE_APP_TITLE=CyberCall
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
